# TinyFish (server-side only). Create a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# Database. SQLite by default (see README for PostgreSQL).
DATABASE_URL="file:./dev.db"
# Public base URL of this deployment. Must be public https for TinyFish monitor webhooks to reach it.
APP_URL=http://localhost:3000
# Shared secret embedded in the monitor webhook URL (TinyFish documents no webhook signature).
WEBHOOK_SECRET=
# Optional: comma-separated bearer keys for programmatic API access (Authorization: Bearer <key>).
VERITY_API_KEYS=
# Optional overrides, used ONLY by the simulated-provider e2e suite. Leave unset in real deployments.
# TINYFISH_SEARCH_URL=
# TINYFISH_FETCH_URL=
# TINYFISH_ AGENT_URL=
# Optional: licensed vendor for India company lookups (https://developer.sandbox.co.in). Test base URL: https://test-api.sandbox.co.in
# SANDBOX_API_KEY=
# SANDBOX_API_SECRET=
# SANDBOX_API_URL=
