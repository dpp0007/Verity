# TinyFish (server-side only). Create a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
# Local database: a SQLite file.
DATABASE_URL="file:./dev.db"
# Production on Vercel: hosted libSQL (Turso). When TURSO_DATABASE_URL is set it is used instead of DATABASE_URL.
# TURSO_DATABASE_URL=libsql://<db>.turso.io
# TURSO_AUTH_TOKEN=
# Public base URL of this deployment. Must be public https for TinyFish monitor webhooks to reach it.
APP_URL=http://localhost:3000
# Shared secret embedded in the monitor webhook URL (TinyFish documents no webhook signature).
WEBHOOK_SECRET=
# Optional: comma-separated bearer keys for programmatic API access (Authorization: Bearer <key>).
VERITY_API_KEYS=
# Production: secret for the Vercel cron route /api/cron/maintenance (8+ characters; Vercel sends it automatically).
# CRON_SECRET=
# Optional overrides, used ONLY by the simulated-provider e2e suite. Leave unset in real deployments.
# TINYFISH_SEARCH_URL=
# TINYFISH_FETCH_URL=
# TINYFISH_AGENT_URL=
# Optional and OFF by default (Verity is TinyFish-only). To enable the licensed third-party vendor for India company lookups,
# set VERITY_ENABLE_THIRD_PARTY_VENDORS=1 together with the keys below
# (https://developer.sandbox.co.in). Test base URL: https://test-api.sandbox.co.in
# SANDBOX_API_KEY=
# SANDBOX_API_SECRET=
# SANDBOX_API_URL=
